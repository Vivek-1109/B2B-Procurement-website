NODE_ENV=production
PORT=3001

# Neon PostgreSQL (PRIMARY DATABASE — required)
DATABASE_URL=postgresql://user:password@your-project.neon.tech/dbname?sslmode=require

# Auth
JWT_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-64-byte-random-hex

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend HTTP API
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=info@b2b.vivek-jha.me
EMAIL_TO=owner@example.com
EMAIL_REPLY_TO=Aprservices20@gmail.com
EMAIL_SANDBOX_MODE=false
EMAIL_DOMAIN_VERIFIED=true
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_SEND_RETRIES=2

# Email branding
COMPANY_NAME=APR Services Enterprise
WEBSITE_URL=https://aprsvs.com
COMPANY_PHONE=+91 99113 94456
COMPANY_ADDRESS=RZ-B3 243/D, Vijay Enclave, South West Delhi, New Delhi-110045
EMAIL_LOGO_URL=https://aprsvs.com/favicon.svg
EMAIL_BRAND_COLOR=#578E7E
SOCIAL_LINKEDIN_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_URL=

# Contact form protection
CONTACT_DUPLICATE_WINDOW_MS=900000
CONTACT_MIN_FORM_COMPLETION_MS=1500

# CORS
ALLOWED_ORIGIN=https://aprsvs.com,https://b2-b-procurement-website.vercel.app

# Admin setup
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-before-seeding
